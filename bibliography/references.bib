@article{domenici_kinematics_1997,
	title = {The {Kinematics} and {Performance} of {Fish} {Fast}-{Start} {Swimming}},
	volume = {200},
	issn = {0022-0949},
	url = {https://doi.org/10.1242/jeb.200.8.1165},
