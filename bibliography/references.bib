	title = {Space-{Time} {Continuum}: {Continuous} {Shape} and {Time} {State} {Estimation} for {Flexible} {Robots}},
	shorttitle = {Space-{Time} {Continuum}},
	url = {http://arxiv.org/abs/2409.12302},
